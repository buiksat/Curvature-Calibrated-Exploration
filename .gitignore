# Overleaf synchronization surface: ignore everything except the paper inputs.
/*
!/.gitignore
!/paper/

# Core manuscript sources.
/paper/*
!/paper/main.tex
!/paper/macros.tex
!/paper/references.bib
!/paper/aistats*.sty
!/paper/aistats*_checklist.tex
!/paper/figures/
!/paper/tables/

# Only the figure and generated tables referenced by main.tex.
/paper/figures/*
!/paper/figures/theory_factor_drift.pdf

/paper/tables/*
!/paper/tables/executed_policy_results.tex
!/paper/tables/linear_bound_ratios.tex
!/paper/tables/covertype_horizon_results.tex
