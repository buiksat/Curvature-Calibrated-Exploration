# Local environments and caches.
.DS_Store
.venv/
buck-out/
.pytest_cache/
**/__pycache__/
*.py[cod]
*.swp
*.swo

# LaTeX build intermediates. The compiled paper/main.pdf is retained.
paper/.backups/
paper/*.aux
paper/*.bbl
paper/*.bcf
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.lof
paper/*.log
paper/*.lot
paper/*.nav
paper/*.out
paper/*.run.xml
paper/*.snm
paper/*.synctex.gz
paper/*.toc
paper/*.vrb
paper/*-blx.bib
paper/main.txt
paper/REVIEW_REQUEST_for_GPTPro.md
paper/true_ggn.tex
paper/figures/*.png
paper/figures/*.png.provenance.json
paper/tables/cg_accuracy_results.tex
paper/tables/cg_accuracy_results.tex.provenance.json
paper/tables/covertype_results.tex
paper/tables/covertype_results.tex.provenance.json
paper/tables/nonlinear_drift_results.tex
paper/tables/nonlinear_drift_results.tex.provenance.json
paper/tables/operator_ablation_results.tex
paper/tables/operator_ablation_results.tex.provenance.json
paper/tables/systems_scaling_results.tex
paper/tables/systems_scaling_results.tex.provenance.json

# Local datasets and scratch experiment outputs.
experiments/data/*
!experiments/data/.gitignore
!experiments/data/.gitkeep
experiments/results/*
!experiments/results/.gitignore
!experiments/results/.gitkeep
results/logs/

# Preserve derived artifacts, but keep all generated seed-level experiment
# output out of Git. Raw runs belong in artifact storage and are represented in
# the repository by compact derived reports and hash/provenance inventories.
results/raw/

# Generated release bundles are reproducible and substantially larger than the
# source checkout. Rebuild them with tools/build_anonymous_supplement.py.
release/
release_review/
anonymous_compact_supplement.zip
anonymous_compact_supplement.zip.sha256
anonymous_review_supplement.zip
anonymous_review_supplement.zip.sha256

# Historical working notes and editor backups are not release inputs.
notes/
