load("@fbcode_macros//build_defs:native_rules.bzl", "buck_sh_binary")

python_library(
    name = "config_lib",
    srcs = ["__init__.py", "config.py"],
    resources = glob(["configs/*"]),
    visibility = ["PUBLIC"],
)

python_library(
    name = "lib",
    srcs = glob(["*.py"], exclude = ["__init__.py", "config.py"]),
    resources = glob(["data/.gitkeep"]),
    deps = [
        ":config_lib",
        "//third_party:matplotlib",
        "//third_party:numpy",
        "//third_party:scipy",
        "fbsource//third-party/pypi/psutil/7.2.2:py",
    ],
    visibility = ["PUBLIC"],
)

[
    python_binary(
        name = module,
        main_module = "experiments." + module,
        deps = [":lib"],
    )
    for module in [
        "aggregate_cg_policy",
