        "run_operator_ablation",
        "run_systems_scaling",
        "run_spectral_tail_study",
        "theory_scaling",
        "theory_scaling_compact",
    ]
]

python_binary(
    name = "config",
    main_module = "experiments.config",
    deps = [":config_lib"],
)

python_binary(
    name = "run_autodiff_systems",
    main_module = "experiments.run_autodiff_systems",
    deps = [
