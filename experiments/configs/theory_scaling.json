{
  "schema_version": 1,
  "name": "theory_scaling",
  "description": "Pre-registered active-subspace scaled-tanh benchmark for rank, excitation, dynamic-width, and growing-window scaling diagnostics.",
  "base": {
    "task": "bounded_active_subspace_near_linear_tanh",
    "rounds": 2048,
    "environment": {
      "model": "sqrt(W) tanh(x^T theta / sqrt(W))",
      "network_width": 4194304.0,
      "action_magnitudes": [-0.5, 1.0],
      "teacher_norm": 0.20,
      "noise_std": 0.10,
      "context_order": "cyclic active coordinate",
      "reward": "conditionally Gaussian"
    },
    "policy": {
      "methods": ["exact_current", "full_cg", "window_q_1_2", "window_q_2_3", "window_q_1", "frozen", "diagonal_current", "greedy"],
      "ridge": 1.0,
      "delta": 0.05,
      "trust_region_radius": 0.50,
      "schedule": "analytic rank bound and excitation-adapted predictable path certificate",
      "teacher_available_before_selection": false
    },
    "optimizer": {
      "algorithm": "separable damped Newton with Euclidean trust-region projection",
      "maximum_iterations": 40,
      "gradient_tolerance": 1e-10,
      "residual_schedule": 1e-6,
      "residual_schedule_semantics": "fixed before action selection and checked against the float64 gradient norm post hoc; the audit is not a verified enclosure"
    },
    "cg": {
      "relative_energy_error": 0.05,
      "max_iterations": 64,
      "condition_bound": "1 + n G^2 / (lambda sigma^2)",
      "explicit_original_system_residual_check": true
    },
    "grid": {
      "ambient_dimensions": [128, 512, 2048],
      "active_ranks": [4, 8, 16],
      "horizons": [128, 256, 512, 1024, 2048],
      "window_exponents": [0.5, 0.6666666666666666, 1.0],
      "selection_rule": "pre-registered before evaluation",
      "primary_hypotheses": [
        "Lambda/log(T) remains bounded for exact current GGN",
        "regret/(sqrt(T) log(T)) remains bounded at fixed rank",
        "window Lambda scales as T^(1-q) and regret as T^(1-q/2) up to logarithms",
        "excitation-adapted schedules tighten lambda-only schedules without observed event failures"
      ]
    },
    "audit": {
      "dense_coordinates": "active subspace only",
      "ambient_cvp": "used by full_cg",
      "numerical_semantics": "all dense eigenvalue, teacher, and exact CG error fields are post-action float64 audits, not enclosures",
      "early_excitation": "full-subspace excitation begins only after the rank-sized cyclic burn-in"
    },
    "output_root": "results/raw/theory_scaling",
    "provenance": {"packages": ["numpy", "scipy", "psutil"]}
  },
