filegroup(
    name="realistic_transport_package_inventory_resources",
    srcs=["BUCK"] + glob(["**"], exclude=["BUCK"]),
    visibility=["PUBLIC"],
)

python_library(
    name="lib",
    srcs=[
        "__init__.py",
        "aggregate.py",
        "artifacts.py",
        "benchmark.py",
        "configuration.py",
        "data.py",
        "environment.py",
        "features.py",
        "io.py",
        "integrity.py",
        "model.py",
        "operators.py",
        "prepare_dataset.py",
        "preprocessing.py",
        "provenance.py",
        "run.py",
        "statistics.py",
        "study.py",
        "teacher.py",
        "tuning.py",
    ],
    deps=[
        "fbsource//third-party/pypi/numpy:numpy",
        "fbsource//third-party/pypi/scipy:scipy",
        "fbsource//third-party/pypi/psutil/7.2.2:py",
        "fbsource//third-party/pypi/threadpoolctl:threadpoolctl",
    ],
    visibility=["PUBLIC"],
)

[
    python_binary(
        name=module,
        main_module="experiments.realistic_transport." + module,
        deps=[":lib"],
    )
    for module in [
        "aggregate",
        "artifacts",
        "run",
        "study",
        "tuning",
    ]
]

python_binary(
    name="prepare_dataset",
    main_module="experiments.realistic_transport.prepare_dataset",
    deps=[
        ":lib",
        "fbsource//third-party/pypi/scikit-learn/1.5.1:py",
    ],
)

